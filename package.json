{
  "name": "prompt-preflight",
  "private": true,
  "workspaces": [
    "core",
    "extension",
    "hook"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "npm run build -w extension && npm run build -w hook",
    "package": "npm run package -w extension"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "https-proxy-agent": "^7.0.6",
    "http-proxy-agent": "^7.0.2",
    "agent-base": "^7.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
